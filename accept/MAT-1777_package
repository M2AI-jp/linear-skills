#!/usr/bin/env python3
# skills/ の下は SKILL.md と harness の2ファイルだけで、説明文が linear の別の意味を除外し、文書の相対リンクが全部解決する
import os
import re
import subprocess
from pathlib import Path

skill = Path("skills/linear-workflow/SKILL.md")
harness = Path("skills/linear-workflow/harness")
tracked = subprocess.run(["git", "ls-files", "skills"], capture_output=True, text=True, check=True).stdout.split()
assert sorted(tracked) == sorted([str(skill), str(harness)]), f"配布物は2ファイル。増やすなら理由を DESIGN.md に: {tracked}"
assert os.access(harness, os.X_OK), "harness が実行できない"
text = skill.read_text(encoding="utf-8")
assert text.startswith("---\n"), skill
frontmatter = text.split("---", 2)[1]
assert "name: linear-workflow\n" in frontmatter and "description:" in frontmatter, skill
# 前の版は linear という語での誤発火で撤去された
assert "線形" in frontmatter, "説明文は linear の別の意味を除外し続ける"
for path in [Path("README.md"), Path("AGENTS.md"), Path("DESIGN.md"), skill]:
    for target in re.findall(r"\]\(([^)]+)\)", path.read_text(encoding="utf-8")):
        if "://" in target or target.startswith("#"):
            continue
        assert (path.parent / target.split("#")[0]).exists(), f"{path}: {target} が無い"
