#!/usr/bin/env python3
"""harness: 導出と門。標準ライブラリだけ。モデルを呼ばず、Linearには書かない。

  harness status              現在地を出す（セッション開始のフックが --hook を付けて呼ぶ）
  harness check               このセッションで生じた食い違いが残っていれば止める（停止のフックが --hook を付けて呼ぶ）
                              入口の無いところから建てたセッションは、建て終わりの判定が通るまで止める（同じ理由は2回まで）
  harness check --wellformed  建て終わったかを判定する
  harness gate [BASE]         緑だった受入を赤にする変更を通さない（CIが呼ぶ）
  harness accept              accept/ の下の受入を1本ずつ走らせる
  harness setup               フックとCIを登録する

入口。AGENTS.md か CLAUDE.md に置く。無いリポジトリでは、何も出さずに終わる。ブロックに書くのは、この5行だけ。
  ## 進め方
  - 正本: <Linear Project のURL>
  - Linearの叩き方: `<GraphQLのJSONを標準入力で受けて、応答のJSONを返すコマンド>`（無ければ環境変数 LINEAR_API_KEY）
  - 受入: `<コマンド>`（行ごとに「緑 <Issue ID> 説明」か「赤 <Issue ID> 説明」を出す。ふつうは harness accept）
  - モジュール: <ディレクトリ> = <Milestone>、…、. = つなぎ
  - 確認が要る: <取り消しにくい操作>

受入のファイル。accept/<Issue ID>_<名前>。実行できること。終了コード0が緑。最初のコメント行が説明になる。
追跡されているファイルだけの場所（main の版）で走る。結果は、版ごとに覚える。
フックは HARNESS_TIMEOUT 秒（既定 240）だけ待つ。終わらなければ走らせ続け、終わった結果を次の呼び出しが使う。
手で走らせたときと gate は、終わるまで待つ。1本ごとの上限も HARNESS_TIMEOUT 秒。
同じ置き場にある、Issue ID で始まらないファイル（共有の関数、データ）は、そこにある受入の一部として比べる。

Issue本文の受入。1行。
  受入（自動）: <観測できる結果> <パス>@<commit>   パスは main にあり、その commit の版から変わっていないこと
                受入が置き場の外のファイル（テストなど）を読むなら、それも <パス>@<commit> で所在に並べる
  受入（証拠）: <観測できる結果> <完了時に、リンクか commit>
  受入（人）: <誰が何を確かめるか>
  受入（見直し）: <どのIssueの受入の抜け道を、別の文脈が挙げて直すか> <完了時に、リンクか commit>

check --wellformed が見るもの。
  入口の5行がある。受入コマンドが main の版で走る（自動の受入が1本も無ければ、行は出なくてよい）。Linearに届き、正本のProjectが引ける
  Todo・In Progress・Done のIssueに受入がある。自動なら所在があり、main の出力に行がある
  Todo の受入は赤（着手前から緑なら、何も確かめていない）。Canceled の受入は消してある
  自動の受入を持つ、開いているIssueは、受入（見直し）のIssueを待っている（Blocked by）
  モジュール表のディレクトリがあり、Milestone と1対1
  スキルを置いた側のフックに status と check が登録してある（.agents なら .codex/hooks.json、.claude なら .claude/settings.json）
  GitHub の remote があれば、CIに gate がある。受入（人）のIssueが1本ある
  commit されていない変更が無い。前線（Blocked by の無い、開いているIssue）がある
"""
import hashlib
import fcntl
import signal
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.request

ID = r"[A-Z][A-Z0-9]*-[0-9]+"
LINE = re.compile(rf"^\s*(緑|赤|green|red)\s+({ID})(?![0-9])[\s:：-]*(.*)$", re.I)
DECL = re.compile(r"^[ \t]*(?:[-*][ \t]+)?(?:\*\*)?受入\s*[（(]\s*(自動|証拠|人|見直し)\s*[）)](?:\*\*)?\s*[:：]\s*(.*)$", re.M)
ANCHOR = re.compile(r"([^\s`@（）()「」、]+)@([0-9a-f]{7,40})(?![0-9a-f])")
TIMEOUT = int(os.environ.get("HARNESS_TIMEOUT", "240"))
OPEN = ("triage", "backlog", "unstarted", "started")
HOOKS = (".claude/settings.json", ".codex/hooks.json")
OWN = re.compile(rf"^{ID}(?![0-9])")                # 受入のファイルと、それだけが読むものは、Issue ID で始まる


def git(*args, cwd=None):
    p = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True, errors="replace")
    return p.returncode, p.stdout.strip()


def sh(cmd, cwd, timeout, stdin=None, env=None, cascade=False):
    p = subprocess.Popen(cmd, shell=True, cwd=cwd, stdin=subprocess.PIPE,
                         stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                         errors="replace", env=env, start_new_session=True)
    def stop(sig=signal.SIGTERM):
        try:
            os.killpg(p.pid, sig)
        except ProcessLookupError:
            pass
    def finish():
        stop()
        try:
            p.communicate(timeout=2)
        except subprocess.TimeoutExpired:
            pass
        finally:
            # shell が先に終わり、出力を閉じた子だけ残る場合も止める。
            stop(signal.SIGKILL)
            p.communicate()
    class Stopped(Exception):
        pass
    def abort(*_):
        # communicate の途中から再び communicate を呼ばず、一度抜けて片づける。
        raise Stopped
    previous = signal.signal(signal.SIGTERM, abort)
    try:
        out, err = p.communicate(stdin, timeout=timeout)
        return p.returncode, out, err
    except Stopped:
        if cascade:
            finish()                         # 下位 harness が、その子を止め終わるのを待つ。
        else:
            stop(signal.SIGKILL)              # 単体の受入は即座に止め、外側と猶予が競合しない。
            p.communicate()
        raise SystemExit(128 + signal.SIGTERM)
    except subprocess.TimeoutExpired:
        finish()
        return None, "", f"{timeout} 秒で終わらなかった"
    finally:
        signal.signal(signal.SIGTERM, previous)


def last_line(text):
    lines = [x for x in text.strip().splitlines() if x.strip()]
    return lines[-1].strip()[:200] if lines else ""


# ---- 入口 ----

KEYS = ("正本", "Linearの叩き方", "受入", "モジュール", "確認が要る")


def parse_entry(text):
    """「## 進め方」のブロックを読む。次の同じ高さ以上の見出しまでがブロック。
    5項目（行頭の「- 項目: 値」、1本ずつ）以外の行は、_extra に集める。入口に、その場かぎりの指示を残さないため。"""
    m = re.search(r"^##[ \t]*進め方[ \t]*$(.*?)(?=^#{1,2}[ \t]|\Z)", text, re.M | re.S)
    if not m:
        return None
    entry, extra = {}, []
    for line in m.group(1).splitlines():
        if not line.strip():
            continue
        item = re.match(r"^-[ \t]+([^:：]+?)[ \t]*[:：][ \t]*(.+)$", line)
        if item and item.group(1) in KEYS and item.group(1) not in entry:
            entry[item.group(1)] = item.group(2).strip()
        else:
            extra.append(line.strip())
    if not entry.get("正本"):
        return None
    entry["_extra"] = extra
    return entry


def read_entry(root):
    for name in ("AGENTS.md", "CLAUDE.md"):
        try:
            with open(os.path.join(root, name), encoding="utf-8") as f:
                entry = parse_entry(f.read())
        except OSError:
            continue
        if entry:
            return entry
    return None


def quoted(value):
    m = re.search(r"`([^`]+)`", value or "")
    return m.group(1).strip() if m else None


class Repo:
    def __init__(self, root):
        self.root = root
        common = git("rev-parse", "--git-common-dir", cwd=root)[1]
        self.inside = os.path.join(os.path.normpath(os.path.join(root, common)), "harness")
        # .git の外の置き場。HARNESS_STORE があればそこだけ。無ければ TMPDIR、/tmp の順。
        # 作業フォルダには置かない（Python の一時フォルダの決め方は、ほかに書けないと作業フォルダに落ちる）。
        name = "harness-" + hashlib.sha256(os.path.realpath(root).encode()).hexdigest()[:16]
        named = os.environ.get("HARNESS_STORE")
        bases = [named] if named else list(dict.fromkeys(b for b in (os.environ.get("TMPDIR"), "/tmp") if b))
        self.outside = [os.path.join(b, name) for b in bases
                        if not (os.path.realpath(b) + os.sep).startswith(os.path.realpath(root) + os.sep)]
        self._store = False
        self.main = self._main()
        self.sha = self.rev(self.main) if self.main else ""
        self.head = self.rev("HEAD")

    @property
    def store(self):
        """書ける置き場。.git の中に書けるならそこ。書けない場所（Codex のサンドボックス）では .git の外。どこにも書けなければ None。"""
        if self._store is False:
            self._store = None
            sandbox = any(k in os.environ for k in ("CODEX_SANDBOX", "CODEX_SANDBOX_NETWORK_DISABLED"))
            for home in (self.outside if sandbox else [self.inside] + self.outside):
                try:
                    os.makedirs(home, exist_ok=True)
                    probe = os.path.join(home, f".probe-{os.getpid()}")
                    with open(probe, "w"):
                        pass
                    os.remove(probe)
                    self._store = home
                    tree = os.path.join(home, "tree")
                    if os.path.isfile(os.path.join(tree, ".git")):      # 前の版が置いた git worktree。登録ごと片づける
                        self.git("worktree", "remove", "--force", tree)
                        shutil.rmtree(tree, ignore_errors=True)
                        self.git("worktree", "prune")
                    break
                except OSError:
                    continue
        return self._store

    def places(self):
        """読む置き場。.git 内に書けるプロセスは、外から置かれた記録を信じない。"""
        return [self.inside] if self.store == self.inside else [self.inside] + self.outside

    def sessions(self):
        """フックのあるセッションが、信頼できる置き場に残した記録。"""
        found = []
        for home in self.places():
            folder = os.path.join(home, "session")
            for name in (os.listdir(folder) if os.path.isdir(folder) else []):
                state = load(os.path.join(folder, name))
                if isinstance(state, dict):
                    found.append(state.get("started") or os.path.getmtime(os.path.join(folder, name)))
        return found

    def rev(self, ref):
        return git("rev-parse", "--verify", "-q", ref + "^{commit}", cwd=self.root)[1]

    def _main(self):
        name = git("symbolic-ref", "--short", "-q", "refs/remotes/origin/HEAD", cwd=self.root)[1]
        name = name.replace("origin/", "", 1)
        for ref in ([name, "origin/" + name] if name else []) + ["main", "origin/main", "master", "origin/master"]:
            if self.rev(ref):
                return ref
        return ""

    def git(self, *args):
        return git(*args, cwd=self.root)


def find_repo():
    rc, root = git("rev-parse", "--show-toplevel")
    return Repo(root) if rc == 0 and root else None


# ---- Linear（読むだけ） ----

class Unreachable(Exception):
    pass


def linear(entry, query, variables):
    payload = json.dumps({"query": query, "variables": variables})
    cmd = quoted(entry.get("Linearの叩き方"))
    try:
        if cmd:
            rc, out, err = sh(cmd, None, 60, stdin=payload)
            if rc != 0:
                raise Unreachable(last_line(err) or last_line(out) or "コマンドが失敗した")
            data = json.loads(out)
        elif os.environ.get("LINEAR_API_KEY"):
            req = urllib.request.Request(
                "https://api.linear.app/graphql", data=payload.encode("utf-8"),
                headers={"Authorization": os.environ["LINEAR_API_KEY"], "Content-Type": "application/json"})
            with urllib.request.urlopen(req, timeout=60) as r:
                data = json.load(r)
        else:
            raise Unreachable("入口の「Linearの叩き方」に、GraphQLのJSONを標準入力で受けるコマンドを `…` で書く"
                              "（または LINEAR_API_KEY を渡す）")
    except (OSError, ValueError) as e:
        raise Unreachable(str(e)[:200]) from None
    if not isinstance(data, dict) or data.get("errors") or not data.get("data"):
        raise Unreachable("Linearがエラーを返した")
    return data["data"]


PROJECT_Q = "query($id:String!){project(id:$id){id name status{type name} projectMilestones{nodes{name}}}}"
ISSUES_Q = """query($id:ID!,$after:String){issues(filter:{project:{id:{eq:$id}}},includeArchived:true,first:100,after:$after){
nodes{identifier title description archivedAt completedAt state{name type} projectMilestone{name}
inverseRelations(first:30){nodes{type issue{identifier state{type}}}}}
pageInfo{hasNextPage endCursor}}}"""


def fetch(entry):
    m = re.search(r"/project/([^/?#\s)>]+)", entry["正本"])
    if not m:
        raise Unreachable("入口の「正本」がLinearのProjectのURLではない")
    project = linear(entry, PROJECT_Q, {"id": m.group(1).rsplit("-", 1)[-1]}).get("project")
    if not project:
        raise Unreachable("入口の「正本」のProjectが引けない")
    issues, after = [], None
    while True:
        page = linear(entry, ISSUES_Q, {"id": project["id"], "after": after})["issues"]
        for n in page["nodes"]:
            decl = DECL.search(n.get("description") or "")
            issues.append({
                "id": n["identifier"], "title": n["title"], "state": n["state"]["name"],
                "type": n["state"]["type"], "archived": bool(n.get("archivedAt")), "done_at": n.get("completedAt"),
                "milestone": (n.get("projectMilestone") or {}).get("name"),
                "kind": decl.group(1) if decl else None, "decl": decl.group(2) if decl else "",
                "waits": sorted(r["issue"]["identifier"] for r in n["inverseRelations"]["nodes"]
                                if r["type"] == "blocks" and r["issue"]["state"]["type"] in OPEN),
                "waited": [r["issue"]["identifier"] for r in n["inverseRelations"]["nodes"]
                           if r["type"] == "blocks" and r["issue"]["state"]["type"] != "canceled"],
            })
        if not page["pageInfo"]["hasNextPage"]:
            break
        after = page["pageInfo"]["endCursor"]
    return {"name": project["name"], "status": project["status"]["type"],
            "milestones": [x["name"] for x in project["projectMilestones"]["nodes"]]}, issues


# ---- 受入 ----

def parse_lines(out):
    """「緑／赤 Issue ID 説明」の行を拾う。赤い行のすぐ下の字下げされた行は、その受入が出した末尾として持つ。"""
    results, last = {}, None
    for line in out.splitlines():
        m = LINE.match(line)
        if m:
            ok = m.group(1).lower() in ("緑", "green")
            old = results.get(m.group(2))
            last = results[m.group(2)] = {"ok": ok and (old["ok"] if old else True),
                                          "text": (old or {}).get("text") or m.group(3).strip(),
                                          "tail": (old or {}).get("tail", [])}
        elif last is not None and not last["ok"] and line.startswith("    ") and len(last["tail"]) < 15:
            last["tail"].append(line.strip()[:300])
        else:
            last = None
    return results


def accept_run(repo, sha):
    """切り離した実行者。結果だけを残す。"""
    entry = None
    for name in ("AGENTS.md", "CLAUDE.md"):
        rc, text = repo.git("show", f"{sha}:{name}")
        entry = entry or (parse_entry(text) if rc == 0 else None)
    cmd = entry and (quoted(entry.get("受入")) or re.split(r"[（(]", entry.get("受入", ""), maxsplit=1)[0].strip())
    if not cmd:
        return {"error": "この版（" + sha[:7] + "）の入口に受入コマンドが無い"}
    tree = os.path.join(repo.store, "tree")
    rc = 0
    if not os.path.isdir(os.path.join(tree, ".git")):
        shutil.rmtree(tree, ignore_errors=True)
        rc, _ = git("clone", "-q", "--shared", "--no-checkout", repo.root, tree)
    if rc == 0:
        rc, _ = git("checkout", "-q", "--force", "--detach", sha, cwd=tree)
    if rc != 0:
        return {"error": "受入を走らせる場所を用意できなかった"}
    rc, out, err = sh(cmd, tree, 3600, env={**os.environ, "HARNESS_ROOT": repo.root}, cascade=True)
    if rc is None:
        return {"error": "受入が " + err}
    results = parse_lines(out)
    if not results and rc != 0:
        return {"error": "受入コマンドの出力に「緑／赤 Issue ID」の行が無い" + ("（" + last_line(err) + "）" if last_line(err) else "")}
    return {"results": results}


def accept_at(repo, sha, fresh=False, wait=None):
    """同じ版の実行を共有する。フックだけは待つ時間を限る。"""
    def left():
        for home in repo.places():
            hit = load(os.path.join(home, "accept", sha + ".json"))
            if isinstance(hit, dict) and ("results" in hit or "error" in hit):
                return hit
    if not repo.store:
        return left() or {"error": "受入を走らせる場所が無い（.git にも、その外にも書けない）"}
    folder = os.path.join(repo.store, "accept")
    os.makedirs(folder, exist_ok=True)
    cache = os.path.join(folder, sha + ".json")
    # 置き場自体をロックする。終わった印のファイルは残さない。
    lock = os.open(folder, os.O_RDONLY)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX)
        def active(path):
            try:
                mark = open(path, "r+")
            except FileNotFoundError:
                return False
            try:
                try:
                    fcntl.flock(mark, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except BlockingIOError:
                    return True
                return False
            finally:
                mark.close()

        for name in os.listdir(folder):
            if not name.endswith(".run") or name == sha + ".run":
                continue
            path = os.path.join(folder, name)
            if not active(path):
                try:
                    os.remove(path)          # ロックの無い印の pid は信じない。
                except FileNotFoundError:
                    pass
                continue
            old = load(path) or {}
            try:
                os.kill(old["pid"], signal.SIGTERM)
                for _ in range(150):
                    if not active(path):
                        break
                    time.sleep(.02)
            except (KeyError, ProcessLookupError):
                pass
            if active(path):
                try:
                    os.kill(old["pid"], signal.SIGKILL)
                except (KeyError, ProcessLookupError):
                    pass
                for _ in range(150):
                    if not active(path):
                        break
                    time.sleep(.02)
            if active(path):
                return {"pending": True} if wait is not None else {"error": "古い版の受入がまだ終了していない"}
            else:
                try:
                    os.remove(path)
                except FileNotFoundError:
                    pass
        running = os.path.join(folder, sha + ".run")
        state = active(running)
        if not state:
            try:
                os.remove(running)
            except FileNotFoundError:
                pass
            if fresh and os.path.exists(cache):
                os.remove(cache)
            elif left():
                return left()
            mark = open(running, "w+")
            fcntl.flock(mark, fcntl.LOCK_EX)
            pid = os.fork()
            if pid == 0:
                os.close(lock)
                os.setsid()
                for fd in (0, 1, 2):
                    null = os.open(os.devnull, os.O_RDWR)
                    os.dup2(null, fd)
                    os.close(null)
                try:
                    while not os.path.exists(running):
                        time.sleep(.01)
                    try:
                        result = accept_run(repo, sha)
                    except Exception as e:
                        result = {"error": "受入の実行に失敗した: " + str(e)}
                    temporary = cache + ".tmp"
                    save(temporary, result)
                    os.replace(temporary, cache)
                finally:
                    if os.path.exists(running):
                        os.remove(running)
                    os._exit(0)
            json.dump({"pid": pid}, mark)
            mark.flush()
            mark.close()
    finally:
        os.close(lock)
    end = time.monotonic() + wait if wait is not None else None
    while True:
        result = left()
        if result:
            return result
        if not os.path.exists(running):
            return left() or {"error": "受入の実行が結果を残さずに終わった"}
        # 印の作成とロックの間を、別の呼出しが実行終了と誤認しない。
        lock = os.open(folder, os.O_RDONLY)
        try:
            fcntl.flock(lock, fcntl.LOCK_EX)
            alive = active(running)
        finally:
            os.close(lock)
        if not alive:
            return left() or {"error": "受入の実行が結果を残さずに終わった"}
        if end is not None and time.monotonic() >= end:
            return {"pending": True}
        time.sleep(.05)


def cmd_accept():
    names = sorted(os.listdir("accept")) if os.path.isdir("accept") else []
    red = False
    for name in names:
        path = os.path.join("accept", name)
        m = re.match(rf"({ID})(?![0-9])", name)
        if not m or not os.path.isfile(path) or not os.access(path, os.X_OK):
            continue
        title = ""
        with open(path, encoding="utf-8", errors="replace") as f:
            for line in f.readlines()[:10]:
                t = re.match(r"\s*(?:#|//|--)\s?(?!!)(.+)", line)
                if t:
                    title = t.group(1).strip()
                    break
        rc, out, err = sh("exec ./" + path, ".", TIMEOUT)
        print(("緑" if rc == 0 else "赤"), m.group(1), title)
        if rc != 0:
            red = True
            for line in (out + err).strip().splitlines()[-15:]:
                print("    " + line)
    return 1 if red else 0


# ---- 導出 ----

def work(repo, ident):
    """Issue の仕事が git のどこにあるか。(main の外にあるか, どこかにあるか, 説明)"""
    grep = ["-i", "-E", "--grep=" + ident + "([^0-9]|$)", "--max-count=1"]
    word = re.compile(rf"(?<![A-Za-z0-9]){re.escape(ident)}(?![0-9])", re.I)
    refs = repo.git("for-each-ref", "--format=%(refname:short)", "refs/heads", "refs/remotes")[1].split()
    named = [r for r in refs if word.search(r)]
    for ref in named:
        ahead = repo.git("rev-list", "--count", f"{repo.main}..{ref}")[1]
        if ahead not in ("", "0"):
            return True, True, f"ブランチ {ref}（main より {ahead} 先）"
    if repo.git("rev-list", "--branches", "--remotes", "--not", repo.main, *grep)[1]:
        return True, True, "main に入っていない commit"
    return False, bool(named or repo.git("rev-list", "--branches", "--remotes", *grep)[1]), ""


def derive(repo, entry, fresh=False, wait=None):
    d = {"problems": [], "front": [], "waiting": [], "backlog": 0, "linear": None, "issues": None}
    acc = accept_at(repo, repo.sha, fresh, wait) if repo.sha else {"error": "commit がまだ無い"}
    d["accept_error"], results = acc.get("error"), acc.get("results")
    d["results"] = results
    d["accept_pending"] = acc.get("pending", False)

    def P(key, text):
        d["problems"].append((key, text))

    try:
        project, issues = fetch(entry)
    except Unreachable as e:
        d["linear"] = str(e)
        return d
    d["issues"], d["project"] = issues, project
    known = {i["id"]: i for i in issues}
    if entry.get("_extra"):
        P("entry", "入口の「進め方」に、5項目以外の行がある: " + " ／ ".join(entry["_extra"][:3])
          + "。入口には、次のセッションでも成り立つことだけを書く")
    anchors, moved = [], {}

    def beside(path, sha):
        """受入（<Issue ID>_<名前>）と同じ置き場にある、Issue ID で始まらないファイルのうち、その版から変わったもの。
        共有の関数やデータは、そこにある受入のどれもが読みうる。書き換えれば、受入を書き換えたのと同じ。"""
        folder, name = os.path.split(path)
        if not folder or not OWN.match(name):
            return []
        if (folder, sha) not in moved:
            names = repo.git("-c", "core.quotepath=false", "diff", "--no-renames", "--name-only", sha, repo.sha, "--", folder)[1]
            moved[(folder, sha)] = [n for n in names.splitlines()
                                    if not any(OWN.match(part) for part in n[len(folder) + 1:].split("/"))]
        return moved[(folder, sha)]

    for i in issues:
        ident, t, kind = i["id"], i["type"], i["kind"]
        result_fault = result_problem(i, results)
        if t == "canceled":
            if result_fault == "stale":
                P("stale:" + ident, f"{ident} {i['state']} だが、受入が残っている。受入を消す")
            continue
        live = t in OPEN or not i["archived"]
        if kind is None:
            if live and t not in ("triage", "backlog"):
                P("noaccept:" + ident, f"{ident} {i['state']} だが、受入が無い"
                  "（Issue本文に「受入（自動）: 観測できる結果 パス@commit」。コードで確かめられないなら（証拠）か（人））")
        elif kind == "自動":
            found = ANCHOR.findall(i["decl"])
            i["anchors"] = [(path.rstrip("/"), sha) for path, sha in found]
            if not found and live and t not in ("triage", "backlog"):
                P("noanchor:" + ident, f"{ident} 受入（自動）に所在（パス@commit）が無い")
            for path, sha in found:
                path = path.rstrip("/")
                anchors.append((ident, path))
                if not repo.rev(sha):
                    P("changed:" + ident, f"{ident} 受入の版 {sha[:7]} がこのリポジトリに無い: {path}")
                elif repo.git("cat-file", "-e", f"{repo.sha}:{path}")[0] != 0:
                    P("changed:" + ident, f"{ident} 受入が main から消えた: {path}。戻すか、基準を人が変えたのならIssueの受入を直す")
                elif repo.git("diff", "--quiet", sha, repo.sha, "--", path)[0] != 0:
                    P("changed:" + ident, f"{ident} 受入が、Issueに書いた版（{sha[:7]}）から変わった: {path}。"
                      "基準を人が変えたのなら、所在を新しい commit に書き直して理由をコメントに残す。そうでなければ戻す")
                elif beside(path, sha):
                    P("changed:" + ident, f"{ident} 受入と同じ置き場の補助が、Issueに書いた版（{sha[:7]}）から変わった: "
                      f"{'、'.join(beside(path, sha)[:3])}。見直しで直した・基準を人が変えたのなら、"
                      "所在を新しい commit に書き直して理由をコメントに残す。そうでなければ戻す")
            if results is not None:
                if result_fault == "noline":
                    P("noline:" + ident, f"{ident} {i['state']} だが、main の受入に出てこない"
                      + ("（成果に到達できない）" if t == "completed" else ""))
                elif result_fault == "red":
                    P("red:" + ident, f"{ident} {i['title']} … {i['state']} なのに受入が落ちている。コードを直すか、Issueを開き直す")
                elif result_fault == "green":
                    P("green:" + ident, f"{ident} 受入が main で緑なのに {i['state']}。"
                      "終わっているなら完了に。着手前から緑なら、受入が何も確かめていない")
        elif kind in ("証拠", "見直し"):
            if t == "completed" and not i["archived"] and not re.search(r"https?://|(?<![0-9a-f])[0-9a-f]{7,40}(?![0-9a-f])", i["decl"]):
                P("noevidence:" + ident, f"{ident} {i['state']}（{kind}）だが、証拠のリンクが無い")
        # 受入は、書いたのとは別の文脈に攻めさせてから実装に入る
        if kind == "自動" and t in ("unstarted", "started") and not any(
                known.get(b, {}).get("kind") == "見直し" for b in i["waited"]):
            P("noreview:" + ident, f"{ident} 受入が、別の文脈に攻めさせるIssueを待っていない"
              "（受入（見直し）のIssueを立て、Blocked by を張る）")
        if t == "started" and i["waits"]:
            P("early:" + ident, f"{ident} が、{'、'.join(i['waits'])} の終わる前に着手されている")
        if t in OPEN:
            outside, anywhere, where = work(repo, ident)
            i["where"] = where
            if t == "started" and kind == "自動" and not anywhere:
                P("nostart:" + ident, f"{ident} {i['state']} だが、ブランチも commit も無い（ブランチ名か commit に Issue ID を入れる）")
            if t != "started" and outside:
                P("moved:" + ident, f"{ident} {where}があるのに {i['state']} のまま。着手中にする")
            if t in ("triage", "backlog"):
                d["backlog"] += 1
            elif i["waits"]:
                d["waiting"].append(i)
            else:
                d["front"].append(i)
    for ident in sorted(set(results or {}) - set(known)):
        P("orphan:" + ident, f"{ident} 受入の出力にあるが、このProjectにIssueが無い")

    # commit されていない変更は、どこにも書き戻されていない現実
    loose = [x.split(None, 1)[1] for x in repo.git("status", "--porcelain")[1].splitlines() if len(x.split(None, 1)) == 2]
    if loose:
        P("dirty", f"commit されていない変更が {len(loose)} 件ある（{'、'.join(loose[:3])}{' ほか' if len(loose) > 3 else ''}）。"
          "commit するか、捨てる（Issueの仕事なら、メッセージに Issue ID を入れる）")

    # このブランチ・作業ツリーが、main にある受入を変えていないか
    base = repo.git("merge-base", "HEAD", repo.sha)[1] if repo.head and repo.sha else ""
    if base and anchors:
        folders = {os.path.dirname(p) for _, p in anchors if os.path.dirname(p) and OWN.match(os.path.basename(p))}
        changed = repo.git("-c", "core.quotepath=false", "diff", "--no-renames", "--name-status", base, "--",
                           *sorted({p for _, p in anchors} | folders))[1]
        for line in changed.splitlines():
            status, _, name = line.partition("\t")
            mine = [ident for ident, path in anchors if name == path or name.startswith(path + "/")]
            if mine and status[:1] in ("M", "D"):
                for ident in mine:
                    P("tree:" + ident, f"{ident} 受入が、このブランチ／作業ツリーで変わっている: {name}。受入は、実装した文脈では変えない")
            elif not mine and any(name.startswith(f + "/") and not any(OWN.match(part) for part in name[len(f) + 1:].split("/"))
                                  for f in folders):                  # 足した補助も、受入が読み込めば期待値を差し替えられる
                P("tree:" + name, f"受入と同じ置き場の補助が、このブランチ／作業ツリーで変わっている: {name}。受入は、実装した文脈では変えない")

    # モジュール表
    table = {}
    for pair in re.split(r"[、,]", entry.get("モジュール", "")):
        if "=" in pair:
            folder, name = (x.strip(" `　") for x in pair.split("=", 1))
            table[name] = folder
            if not os.path.isdir(os.path.join(repo.root, folder)):
                P("module:" + folder, f"入口のモジュール {folder} が無い")
            if name not in project["milestones"]:
                P("module:" + name, f"入口の Milestone「{name}」がProjectに無い")
    for name in project["milestones"]:
        if name not in table:
            P("module:" + name, f"Milestone「{name}」に対応するディレクトリが入口に無い")

    # Project の状態
    opened = [i for i in issues if i["type"] in OPEN]
    green = results is not None and all(r["ok"] for r in results.values())
    if project["status"] == "completed":
        if opened or (results is not None and not green):
            P("project", "Project は完了になっているが、" + ("開いているIssueがある" if opened else "受入が落ちている"))
    elif project["status"] != "canceled" and issues and not opened and green:
        P("project", "開いているIssueが無く、受入が全部緑。Project を完了にする")
    return d


def linear_hint(message):
    if any(k in os.environ for k in ("CODEX_SANDBOX", "CODEX_SANDBOX_NETWORK_DISABLED")):
        message += "。Codexのサンドボックスの中からは、ふつう届かない（故障ではない）。確かめるなら、サンドボックスの外で走らせる。フックは外で動くので、現在地と停止の門には届いている。建て終わりも、フックが登録してあれば、止まるときに停止のフックが判定する（止められなければ、整っている）"
    return message


def render(repo, entry, d):
    out = [f"現在地（導出 {repo.main or '?'}@{repo.sha[:7]}）"]
    if repo.head and repo.head != repo.sha:
        name = repo.git("rev-parse", "--abbrev-ref", "HEAD")[1]
        ahead = repo.git("rev-list", "--count", f"{repo.sha}..HEAD")[1]
        out.append(f"いま  {name}@{repo.head[:7]}（main より {ahead} 先）")
    results, known = d["results"], {i["id"]: i for i in d["issues"] or []}
    if d.get("accept_pending"):
        out.append(f"受入  走らせ続けている（{TIMEOUT} 秒では終わらなかった。終わった結果は、次の呼び出しが使う）")
    elif results is None:
        out.append("受入  走らせられなかった: " + d["accept_error"])
    elif d["issues"] is None:
        out.append(f"受入  緑 {sum(r['ok'] for r in results.values())} ／ 赤 {sum(not r['ok'] for r in results.values())}")
    else:
        red = [k for k, r in results.items() if not r["ok"] and known.get(k, {}).get("type") not in OPEN]
        todo = [k for k, r in results.items() if not r["ok"] and k not in red]
        out.append(f"受入  緑 {sum(r['ok'] for r in results.values())} ／ 赤 {len(red)} ／ 未実装 {len(todo)}")
    if d["linear"]:
        out.append(linear_hint("Linear  届かない: " + d["linear"]) + "（Linearの状態は確かめていない）")
    else:
        def row(i):
            extra = [i["state"]] + ([i["where"]] if i.get("where") else [])
            return f"{i['id']} {i['title']}（{'、'.join(extra)}）"
        front = sorted(d["front"], key=lambda i: i["type"] != "started")
        for n, i in enumerate(front[:12]):
            out.append(("前線  " if n == 0 else "      ") + row(i))
        if len(front) > 12:
            out.append(f"      ほか {len(front) - 12} 件")
        if not front:
            out.append("前線  なし")
        for n, i in enumerate(d["waiting"][:12]):
            out.append(("待ち  " if n == 0 else "      ") + f"{i['id']} {i['title']}（{'、'.join(i['waits'])} 待ち）")
        if d["backlog"]:
            out.append(f"Backlog  {d['backlog']} 件（受入はまだ無い）")
        if d["problems"]:
            out.append("食い違い")
            out += ["  " + text for _, text in d["problems"]]
            out.append("  直し方は " + guide(repo) + " の「引き直す」")
        else:
            out.append("食い違い  なし")
    if entry.get("確認が要る"):
        out.append("確認が要る  " + entry["確認が要る"])
    return "\n".join(out)


def guide(repo):
    here = os.path.join(os.path.dirname(os.path.realpath(__file__)), "SKILL.md")
    root = os.path.realpath(repo.root)
    return os.path.relpath(here, root) if here.startswith(root + os.sep) else here


# ---- フックの入出力 ----

def hook_input(argv):
    """フックから呼ばれたとき（--hook）だけ標準入力を読む。手で走らせたときは読まない。"""
    if "--hook" not in argv:
        return {}
    try:
        data = json.loads(sys.stdin.read() or "{}")
        return data if isinstance(data, dict) else {}
    except ValueError:
        return {}


def session_file(repo, hook):
    sid = re.sub(r"[^A-Za-z0-9_.-]", "_", str(hook.get("session_id") or ""))
    return os.path.join(repo.store, "session", sid + ".json") if sid and repo.store else None


def load(path):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError, TypeError):
        return None


def save(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False)


def result_problem(issue, results):
    """受入結果に依る食い違い。現在地と開始時の結果で同じ述語を使う。"""
    if results is None:
        return None
    ident, t = issue["id"], issue["type"]
    res = results.get(ident)
    if t == "canceled":
        return "stale" if res is not None else None
    if issue["kind"] == "自動":
        if res is None and (t in OPEN or not issue["archived"]) and t not in ("triage", "backlog"):
            return "noline"
        if res and not res["ok"] and t == "completed":
            return "red"
        if res and res["ok"] and t in OPEN:
            return "green"


def baseline(repo, d):
    """セッションの開始時に覚えておくもの。止めるのは、ここに無かった食い違いだけ。"""
    return {"keys": sorted(k for k, _ in d["problems"]), "blocks": {}, "started": time.time(), "head": repo.head, "accept_sha": repo.sha,
            # 受入の結果がまだ無いときだけ、あとで突き合わせるために、Issueの状態を覚えておく
            "accept_unknown": d["results"] is None,
            "accept_start": [{"id": i["id"], "type": i["type"], "kind": i["kind"], "archived": i["archived"]}
                             for i in d["issues"]] if d["results"] is None else [],
            "project_start": d["project"]["status"],
            "reviews_done": [i["id"] for i in d["issues"] if i["kind"] == "見直し" and i["type"] == "completed"]}


def absorb_results(repo, path, state):
    if state and not state.get("building") and state.get("accept_unknown"):
        cached = next((hit for home in repo.places()
                       for hit in [load(os.path.join(home, "accept", state.get("accept_sha", "") + ".json"))]
                       if isinstance(hit, dict) and "results" in hit), None)
        if cached is None:
            return
        issues, results = state.get("accept_start", []), cached["results"]
        keys = []
        for i in issues:
            problem = result_problem(i, results)
            if problem:
                keys.append(problem + ":" + i["id"])
        keys += ["orphan:" + ident for ident in set(results) - {i["id"] for i in issues}]
        opened = any(i["type"] in OPEN for i in issues)
        green = all(r["ok"] for r in results.values())
        status = state.get("project_start")
        if (status == "completed" and (opened or not green)) or (
                status not in ("completed", "canceled", None) and issues and not opened and green):
            keys.append("project")
        state["keys"] = sorted(set(state["keys"]) | set(keys))
        state["accept_unknown"] = False
        save(path, state)


def self_reviews(repo, d, state):
    """このセッションが書いた受入の見直しを、このセッションが閉じていないか。"""
    start, out = state.get("head"), []
    if not start:
        return out
    for r in d["issues"]:
        if r["kind"] != "見直し" or r["type"] != "completed" or r["id"] in state.get("reviews_done", []):
            continue
        mine = [x["id"] for x in d["issues"] if x["kind"] == "自動" and r["id"] in x["waited"]
                and any(repo.git("cat-file", "-e", f"{start}:{path}")[0] != 0 for path, _ in x.get("anchors", []))]
        if mine:
            out.append(("selfreview:" + r["id"], f"{r['id']} 受入を書いたセッションが、その見直しを閉じている（{'、'.join(mine)}）。"
                        "見直しを開き直して、別のセッションに任せる"))
    return out


def built_reviews(repo, d):
    """建てたセッションが、自分で見直しを閉じて終えていないか。建て終わりの判定だけが見る。"""
    out, sessions = [], repo.sessions()
    for r in d["issues"]:
        if r["kind"] != "見直し" or r["type"] != "completed":
            continue
        waiting = [x for x in d["issues"] if x["kind"] == "自動" and r["id"] in x["waited"]]
        times = [int(t) for x in waiting for _, sha in x.get("anchors", [])
                 for t in [repo.git("show", "-s", "--format=%ct", sha)[1]] if t.isdigit()]
        if not waiting or not times or any(x["type"] != "unstarted" for x in waiting):
            continue                                        # もう着手している。建て終わりの話ではない
        try:
            closed = time.mktime(time.strptime((r.get("done_at") or "")[:19], "%Y-%m-%dT%H:%M:%S")) - time.timezone
        except ValueError:
            closed = time.time()
        if not any(max(times) < started <= closed for started in sessions):   # 受入が置かれてから閉じるまでに始まったセッションが無い
            out.append(f"{r['id']} 受入の見直しが、建てたセッションのうちに閉じている。開き直して、次のセッションに任せる")
    return out


def cmd_status(repo, entry, hook, fresh):
    d = derive(repo, entry, fresh, TIMEOUT if hook.get("hook_event_name") else None)
    text = render(repo, entry, d)
    path = session_file(repo, hook)
    if path and not d["linear"]:
        absorb_results(repo, path, load(path))
    if path and not os.path.exists(path) and not d["linear"]:
        save(path, baseline(repo, d))
        folder = os.path.dirname(path)
        for name in os.listdir(folder):
            if time.time() - os.path.getmtime(os.path.join(folder, name)) > 14 * 86400:
                os.remove(os.path.join(folder, name))
    if hook.get("hook_event_name"):
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": text}},
                         ensure_ascii=False))
    else:
        print(text)
    return 0


def cmd_check(repo, entry, hook):
    """このセッションで生じた食い違いが残っていれば止める。同じ理由で止めるのは2回まで。"""
    d = derive(repo, entry, wait=TIMEOUT if hook.get("hook_event_name") else None)
    as_hook = bool(hook.get("hook_event_name"))
    if d["linear"]:
        if as_hook:
            print(json.dumps({"systemMessage": linear_hint("harness: Linearに届かないので、状態を確かめずに通した（" + d["linear"] + "）")},
                             ensure_ascii=False))
        else:
            print(linear_hint("Linearに届かない: " + d["linear"]))
        return 0
    path = session_file(repo, hook)
    if as_hook and not path:
        return 0                                            # 開始時の状態を覚えておく場所が無い。何が新しいか分からないので、止めない
    state = (load(path) if path else None)
    if path and state is None:
        save(path, baseline(repo, d))
        return 0
    if state:
        absorb_results(repo, path, state)
        d["problems"] += self_reviews(repo, d, state)
    building = bool(state and state.get("building"))
    if building:
        faults = wellformed_faults(repo, entry, d)
        if not faults:
            state["building"] = False
            state["keys"] = sorted(k for k, _ in d["problems"])
            state["blocks"] = {}
            save(path, state)
            return 0
        new = [("build:" + text, text) for text in faults]
    else:
        known = set(state["keys"]) if state else set()
        new = [(k, t) for k, t in d["problems"] if k not in known]
    if not new:
        return 0
    lines = "\n".join("  " + t for _, t in new)
    digest = hashlib.sha256("\n".join(sorted(k for k, _ in new)).encode()).hexdigest()[:16]
    if state is not None:
        count = state["blocks"].get(digest, 0)
        if count >= 2:
            print(json.dumps({"systemMessage": "harness: 同じ理由で2回止めたので通した。食い違いは残っている\n" + lines},
                             ensure_ascii=False))
            return 0
        state["blocks"][digest] = count + 1
        save(path, state)
    reason = (("まだ整っていない。建て終わりの判定で名指しされたものを直す。\n" if building else
               "止める前に、このセッションで生じた食い違いを直す。\n") + lines + "\n"
              "手順は " + guide(repo) + " の「引き直す」。同じ理由で止めるのは2回まで。")
    if as_hook:
        print(json.dumps({"decision": "block", "reason": reason}, ensure_ascii=False))
        return 0
    print(reason)
    return 1


def wellformed_faults(repo, entry, d):
    faults = [f"入口に「{k}」が無い" for k in ("正本", "Linearの叩き方", "受入", "モジュール", "確認が要る") if not entry.get(k)]
    if d.get("accept_pending"):
        faults.append("受入を走らせ続けている。結果が出てから建て終わりを判定する")
    if d["accept_error"]:
        faults.append("受入を走らせられない: " + d["accept_error"])
    if d["linear"]:
        faults.append(linear_hint("Linearに届かない: " + d["linear"]))
    faults += [text for _, text in d["problems"]]
    if d["issues"] is not None and not d["front"] and not d["waiting"]:
        faults.append("前線が無い（受入を持つ、開いているIssueが無い）")
    if d["issues"] is not None:
        faults += built_reviews(repo, d)
    if d["issues"] is not None and not any(i["kind"] == "人" and i["type"] != "canceled" for i in d["issues"]):
        faults.append("人が確かめるIssue（受入（人））が無い。仮置きにした基準か、できあがりが意図に合っているかを、人が確かめるIssueを1本立てる")
    texts = {}
    for name in HOOKS:
        try:
            with open(os.path.join(repo.root, name), encoding="utf-8") as f:
                texts[name] = f.read()
        except OSError:
            texts[name] = ""
    # スキルを置いた側のフックが要る。.agents なら Codex、.claude なら Claude Code。どちらにも置いていなければ、どちらか
    placed = [name for name, folder in ((".claude/settings.json", ".claude"), (".codex/hooks.json", ".agents"))
              if os.path.exists(os.path.join(repo.root, folder, "skills", "linear-workflow", "SKILL.md"))]
    for sub in ("status", "check"):
        has = {name: bool(re.search(r"harness\W.{0,80}?\b" + sub, text)) for name, text in texts.items()}
        for name in placed:
            if not has[name]:
                faults.append(f"フックに harness {sub} が登録されていない（{name}）。harness setup を走らせる"
                              + ("。Codexのサンドボックスは .codex に書けないので、サンドボックスの外で" if name.startswith(".codex") else ""))
        if not placed and not any(has.values()):
            faults.append(f"フックに harness {sub} が登録されていない（harness setup）")
    if "github.com" in repo.git("remote", "get-url", "origin")[1]:
        flows = os.path.join(repo.root, ".github", "workflows")
        texts = ""
        for name in (os.listdir(flows) if os.path.isdir(flows) else []):
            with open(os.path.join(flows, name), encoding="utf-8", errors="replace") as f:
                texts += f.read()
        if not re.search(r"harness\W+gate", texts):
            faults.append("CIに harness gate が無い（harness setup）")
    return faults


def cmd_wellformed(repo, entry):
    d = derive(repo, entry, fresh=True)
    faults = wellformed_faults(repo, entry, d)
    if faults:
        print("まだ整っていない")
        print("\n".join("  " + x for x in faults))
        return 1
    print("整っている")
    print(render(repo, entry, d))
    return 0


def cmd_gate(repo, base):
    """緑だった受入が、赤になるか消えるなら通さない。"""
    if not repo.head:
        return 0
    if base and re.fullmatch(r"0+", base):
        base = ""
    start = repo.git("merge-base", base or repo.sha or "HEAD", "HEAD")[1] if (base or repo.sha) else ""
    if start == repo.head:
        start = repo.rev("HEAD~1")
    before = accept_at(repo, start).get("results") if start else None
    if not before:
        print("基準の版に受入が無い。通す")
        return 0
    after = accept_at(repo, repo.head, fresh=True)
    now = after.get("results") or {}
    broken = [k for k, r in before.items() if r["ok"] and not (now.get(k) or {}).get("ok")]
    for k in sorted(broken):
        print(f"{k} {before[k]['text']} … 緑だった受入が" + ("赤になった" if k in now else "消えた"))
    if after.get("error"):
        print("受入を走らせられなかった: " + after["error"])
    red = sorted(k for k, r in now.items() if not r["ok"])
    print(f"この版の受入  緑 {len(now) - len(red)} ／ 赤 {len(red)}" + ("（" + "、".join(red) + "）" if red else ""))
    for k in red:
        print(f"  赤 {k} {now[k]['text']}")
        for line in now[k].get("tail", []):
            print("      " + line)
    if broken:
        return 1
    print(f"緑だった受入 {sum(r['ok'] for r in before.values())} 本は緑のまま")
    return 0


def cmd_setup(repo):
    here = os.path.realpath(__file__)
    inside = here.startswith(os.path.realpath(repo.root) + os.sep)
    rel = os.path.relpath(here, os.path.realpath(repo.root)) if inside else here
    target = '"$(git rev-parse --show-toplevel 2>/dev/null)/' + rel + '"' if inside else '"' + rel + '"'
    failed = []
    for name in HOOKS:
        path = os.path.join(repo.root, name)
        data = load(path) if os.path.exists(path) else {}
        if not isinstance(data, dict):
            print(f"{name} が読めない。手で直してからやり直す")
            return 1
        before = json.dumps(data, sort_keys=True)
        hooks = data.setdefault("hooks", {})
        for event, sub in (("SessionStart", "status"), ("Stop", "check")):
            groups = hooks.setdefault(event, [])
            cmd = f"h={target}; [ -x \"$h\" ] && exec \"$h\" {sub} --hook; exit 0"
            mine = [h for g in groups for h in g.get("hooks", [])
                    if re.search(r"harness\W.{0,80}?\b" + sub, h.get("command", ""))]
            for h in mine:
                h["command"] = cmd
            if not mine:
                groups.append({"hooks": [{"type": "command", "command": cmd, "timeout": TIMEOUT + 60}]})
        if json.dumps(data, sort_keys=True) != before or not os.path.exists(path):
            try:
                os.makedirs(os.path.dirname(path), exist_ok=True)
                with open(path, "w", encoding="utf-8") as f:
                    json.dump(data, f, ensure_ascii=False, indent=2)
                    f.write("\n")
            except OSError:
                failed.append(name)
                print("書けなかった: " + name)
                continue
        print("フック: " + name)
    print("Codex では、このリポジトリを信頼し、フックを確認する操作が初回に要る。済むまで、Codex はフックを黙って走らせない")
    if failed:
        print("ここには書けない。Codexのサンドボックスは .codex に書けないので、サンドボックスの外で harness setup をもう一度走らせる")
    if "github.com" in repo.git("remote", "get-url", "origin")[1] and inside:
        path = os.path.join(repo.root, ".github", "workflows", "accept.yml")
        if not os.path.exists(path):
            os.makedirs(os.path.dirname(path), exist_ok=True)
            branch = (repo.main or "main").replace("origin/", "", 1)
            with open(path, "w", encoding="utf-8") as f:
                f.write("name: accept\non:\n  pull_request:\n  push:\n    branches: [" + branch + "]\n"
                        "permissions:\n  contents: read\n"
                        "jobs:\n  gate:\n    runs-on: ubuntu-latest\n    timeout-minutes: 20\n    steps:\n"
                        "      - uses: actions/checkout@v7\n        with:\n          fetch-depth: 0\n"
                        "          persist-credentials: false\n"
                        "      - run: " + rel + ' gate "${{ github.event.pull_request.base.sha || github.event.before }}"\n')
            print("CI: .github/workflows/accept.yml")
    return 1 if failed else 0


def main(argv):
    sub = argv[0] if argv else ""
    if sub == "accept":
        return cmd_accept()
    if sub not in ("status", "check", "gate", "setup"):
        print(__doc__.strip())
        return 0 if sub in ("", "-h", "--help") else 2
    repo = find_repo()
    if not repo:
        return 0
    if sub == "gate":
        return cmd_gate(repo, argv[1] if len(argv) > 1 else "")
    if sub == "setup":
        return cmd_setup(repo)
    entry = read_entry(repo.root)
    if sub == "check" and "--wellformed" in argv:
        if not entry:
            print("まだ整っていない\n  入口が無い（AGENTS.md に「## 進め方」と「- 正本: <ProjectのURL>」）")
            return 1
        return cmd_wellformed(repo, entry)
    hook = hook_input(argv)
    if not entry:
        if sub == "status" and hook.get("hook_event_name") == "SessionStart":
            path = session_file(repo, hook)
            if path and not os.path.exists(path):
                save(path, {"keys": [], "blocks": {}, "started": time.time(), "head": repo.head,
                            "reviews_done": [], "building": True})
        return 0
    if sub == "status":
        return cmd_status(repo, entry, hook, "--fresh" in argv)
    return cmd_check(repo, entry, hook)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except BrokenPipeError:
        sys.exit(0)
