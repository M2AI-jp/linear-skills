{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$(git rev-parse --show-toplevel 2>/dev/null)/skills/linear-workflow/harness\"; [ -x \"$h\" ] && exec \"$h\" status; exit 0",
            "timeout": 300
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$(git rev-parse --show-toplevel 2>/dev/null)/skills/linear-workflow/harness\"; [ -x \"$h\" ] && exec \"$h\" check; exit 0",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
