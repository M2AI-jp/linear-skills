{
  "description": "現行Projectの文脈、対象・状態・依存の機械検査、読戻しと一度の終了照合。意味の受入はPMが実結果で判断する。",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/absolute/path/to/workspace/hooks/runtime.py\"",
            "timeout": 30,
            "additionalContextLimit": 2400
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/absolute/path/to/workspace/hooks/runtime.py\"",
            "timeout": 30,
            "additionalContextLimit": 2400
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/absolute/path/to/workspace/hooks/runtime.py\"",
            "timeout": 30,
            "additionalContextLimit": 2400
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/absolute/path/to/workspace/hooks/runtime.py\"",
            "timeout": 30,
            "additionalContextLimit": 2400
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/absolute/path/to/workspace/hooks/runtime.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/absolute/path/to/workspace/hooks/runtime.py\"",
            "timeout": 30,
            "additionalContextLimit": 2400
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/absolute/path/to/workspace/hooks/runtime.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
